/* ================================
   SHAN CLOTH - LUXURY BACKGROUND
================================ */

body {
    margin: 0;
    padding: 0;
    background:
        radial-gradient(circle at 20% 20%, rgba(212, 175, 55, 0.10), transparent 30%),
        radial-gradient(circle at 80% 80%, rgba(212, 175, 55, 0.08), transparent 30%),
        linear-gradient(135deg, #050505, #111111, #050505);
    background-attachment: fixed;
    color: #ffffff;
    font-family: "Poppins", Arial, sans-serif;
}


/* Luxury texture overlay */

body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;

    background-image:
        linear-gradient(
            45deg,
            rgba(255,255,255,0.015) 25%,
            transparent 25%,
            transparent 50%,
            rgba(255,255,255,0.015) 50%,
            rgba(255,255,255,0.015) 75%,
            transparent 75%
        );

    background-size: 8px 8px;
    opacity: 0.4;
}


/* ================================
   LUXURY SECTIONS
================================ */

section {
    position: relative;
    overflow: hidden;
}


/* Golden glow */

section::before {
    content: "";
    position: absolute;

    width: 350px;
    height: 350px;

    background: radial-gradient(
        circle,
        rgba(212,175,55,0.10),
        transparent 70%
    );

    top: -150px;
    left: -150px;

    pointer-events: none;
}


/* ================================
   HERO LUXURY BACKGROUND
================================ */

.hero {
    position: relative;

    min-height: 700px;

    display: flex;
    align-items: center;
    justify-content: center;

    text-align: center;

    background:
        linear-gradient(
            rgba(0,0,0,0.65),
            rgba(0,0,0,0.85)
        ),
        url("https://images.unsplash.com/photo-1617127365659-c47fa864d8bc?auto=format&fit=crop&w=2000&q=90");

    background-size: cover;
    background-position: center;

    background-attachment: fixed;
}


/* Golden light behind hero */

.hero::after {
    content: "";

    position: absolute;

    width: 500px;
    height: 500px;

    background: radial-gradient(
        circle,
        rgba(212,175,55,0.16),
        transparent 70%
    );

    filter: blur(20px);

    pointer-events: none;
}


/* Hero text */

.hero-content {
    position: relative;
    z-index: 2;
}


.hero h1 {
    font-size: 70px;
    letter-spacing: 7px;

    text-shadow:
        0 0 10px rgba(212,175,55,0.3),
        0 0 30px rgba(212,175,55,0.15);
}


.hero h1 .gold {
    color: #d4af37;
}


/* ================================
   GOLD LUXURY BUTTON
================================ */

.btn {
    position: relative;

    display: inline-block;

    padding: 16px 40px;

    color: #111;

    background: linear-gradient(
        135deg,
        #b8860b,
        #d4af37,
        #f5d76e,
        #d4af37,
        #b8860b
    );

    background-size: 300% 300%;

    border: none;

    font-weight: bold;

    letter-spacing: 1px;

    box-shadow:
        0 5px 20px rgba(212,175,55,0.25);

    transition: 0.4s;

    animation: goldMove 5s ease infinite;
}


.btn:hover {
    transform: translateY(-4px) scale(1.03);

    box-shadow:
        0 10px 35px rgba(212,175,55,0.45);
}


@keyframes goldMove {

    0% {
        background-position: 0% 50%;
    }

    50% {
        background-position: 100% 50%;
    }

    100% {
        background-position: 0% 50%;
    }

}


/* ================================
   PRODUCT SECTION
================================ */

#products {
    background:
        linear-gradient(
            rgba(5,5,5,0.94),
            rgba(12,12,12,0.94)
        );
}


/* Product cards */

.product {
    position: relative;

    background:
        linear-gradient(
            145deg,
            #171717,
            #0c0c0c
        );

    border: 1px solid rgba(212,175,55,0.18);

    box-shadow:
        0 15px 40px rgba(0,0,0,0.5);

    transition: all 0.4s ease;

    overflow: hidden;
}


.product::before {
    content: "";

    position: absolute;

    top: 0;
    left: -100%;

    width: 100%;
    height: 2px;

    background: linear-gradient(
        90deg,
        transparent,
        #d4af37,
        transparent
    );

    transition: 0.6s;
}


.product:hover::before {
    left: 100%;
}


.product:hover {
    transform: translateY(-10px);

    border-color: rgba(212,175,55,0.7);

    box-shadow:
        0 20px 50px rgba(212,175,55,0.12);
}


/* Product image */

.product img {
    transition: transform 0.6s ease;
}


.product:hover img {
    transform: scale(1.06);
}


/* ================================
   GOLD TEXT
================================ */

.gold {
    background: linear-gradient(
        90deg,
        #b8860b,
        #d4af37,
        #ffe8a3,
        #d4af37,
        #b8860b
    );

    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;

    background-size: 200% auto;

    animation: goldText 5s linear infinite;
}


@keyframes goldText {

    to {
        background-position: 200% center;
    }

}


/* ================================
   ABOUT SECTION
================================ */

.about {
    position: relative;

    background:
        radial-gradient(
            circle at center,
            rgba(212,175,55,0.08),
            transparent 55%
        ),
        #080808;
}


/* ================================
   ORDER SECTION
================================ */

#order {
    background:
        linear-gradient(
            135deg,
            #080808,
            #111111,
            #080808
        );
}


/* Order box */

.order {
    background:
        linear-gradient(
            145deg,
            rgba(30,30,30,0.95),
            rgba(10,10,10,0.98)
        );

    border: 1px solid rgba(212,175,55,0.3);

    box-shadow:
        0 20px 60px rgba(0,0,0,0.6),
        0 0 40px rgba(212,175,55,0.04);
}


/* Input luxury effect */

.order input,
.order select,
.order textarea {
    background: #080808;

    border: 1px solid #333;

    color: white;

    transition: 0.3s;
}


.order input:focus,
.order select:focus,
.order textarea:focus {

    border-color: #d4af37;

    box-shadow:
        0 0 15px rgba(212,175,55,0.12);
}


/* ================================
   FOOTER
================================ */

footer {
    position: relative;

    background:
        radial-gradient(
            circle at center,
            rgba(212,175,55,0.06),
            transparent 60%
        ),
        #030303;

    border-top: 1px solid rgba(212,175,55,0.25);
}


/* ================================
   PREMIUM GOLD LINE
================================ */

.section-title h2::after {

    content: "";

    display: block;

    width: 70px;
    height: 2px;

    margin: 15px auto;

    background: linear-gradient(
        90deg,
        transparent,
        #d4af37,
        transparent
    );

}


/* ================================
   MOBILE
================================ */

@media (max-width: 768px) {

    .hero {
        background-attachment: scroll;
        min-height: 600px;
    }

    .hero h1 {
        font-size: 42px;
        letter-spacing: 4px;
    }

    .product {
        margin-bottom: 10px;
    }

}
