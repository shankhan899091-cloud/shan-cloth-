        function placeOrder(event) {

            event.preventDefault();

            const name =
                document.getElementById("name").value;

            const phone =
                document.getElementById("phone").value;

            const address =
                document.getElementById("address").value;

            const product =
                document.getElementById("productSelect").value;

            const size =
                document.getElementById("size").value;

            const message =
                document.getElementById("message").value;


            /*
             * IMPORTANT:
             * Apna WhatsApp number neeche enter karein.
             * Country code ke saath number likhein.
             *
             * Example Pakistan:
             * 923001234567
             */

            const whatsappNumber = "923001234567";


            const text =
                "SHAN CLOTH - NEW ORDER%0A%0A" +
                "Name: " + name + "%0A" +
                "Phone: " + phone + "%0A" +
                "Address: " + address + "%0A" +
                "Product: " + product + "%0A" +
                "Size: " + size + "%0A" +
                "Message: " + message;


            const whatsappURL =
                "https://wa.me/" +
                whatsappNumber +
                "?text=" +
                text;


            window.open(
                whatsappURL,
                "_blank"
            );

        }

